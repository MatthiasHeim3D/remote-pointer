<Window x:Class="RemotePointer.Client.Overlays.TargetRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Focusable="True"
        ResizeMode="NoResize"
        MinWidth="280"
        MinHeight="180"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseDown="OnPreviewMouseDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseUp="OnPreviewMouseUp">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#F5F5F5" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#60CDFF" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Outlined rather than filled, so the accent-filled Start button is unmistakably
             the primary action even without a panel grouping the controls. -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#59202020" />
            <Setter Property="BorderBrush" Value="#4DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Background="Transparent" Orientation="Horizontal">
                            <Border x:Name="Track"
                                    Width="38"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="#8C555555"
                                    CornerRadius="10">
                                <Ellipse x:Name="Knob"
                                         Width="14"
                                         Height="14"
                                         Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="White" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#60CDFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="#17242A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One template for all four corners; each instance mirrors it into place, so the
             grip always points outwards at the corner it sizes. -->
        <Style x:Key="CornerGripStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 7 20 L 20 20 L 20 7"
                                  Stroke="#F5F5F5"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.95" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder"
            BorderBrush="#60CDFF"
            BorderThickness="3"
            Background="#16000000"
            CornerRadius="6">
        <Grid x:Name="TargetSurface">
            <Canvas x:Name="RippleCanvas" IsHitTestVisible="False" />
            <Canvas x:Name="EditorCanvas" IsHitTestVisible="False" />

            <!-- The controls sit directly on the target area instead of in a panel, so the
                 window shows as much of the screen underneath it as possible. Rows rather than
                 an overlay, so heading, handle and buttons can never collide when the target
                 area is sized down to its minimum. Anywhere that is not a control drags the
                 window; the centre glyph is what advertises that. -->
            <Grid x:Name="CalibrationPanel"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="OnDragSurfaceMouseLeftButtonDown"
                  ToolTip="Drag to move">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sized from code to whatever the row leaves free. -->
                <Border x:Name="DragSurface"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Opacity="0.4">
                    <TextBlock x:Name="MoveHandleIcon"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7C2;" />
                </Border>

                <StackPanel x:Name="CalibrationHeader"
                            Margin="16,14,16,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#D2D2D2"
                               Text="Calibrate target area" />
                    <TextBlock x:Name="CalibrationDescription"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="#8F8F8F"
                               Text="Move and resize this window over the shared screen"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="AspectWarningPanel"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="#FFB900"
                                   Text="&#xE7BA;" />
                        <TextBlock Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFD36A"
                                   Text="Aspect ratio mismatch" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="CalibrationControls"
                            Grid.Row="2"
                            Margin="16,4,16,16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                    <CheckBox x:Name="AspectLockCheckBox"
                              Margin="0,0,0,12"
                              HorizontalAlignment="Center"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Checked="OnAspectLockChanged"
                              Unchecked="OnAspectLockChanged"
                              Content="Lock aspect ratio" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Margin="0,0,7,6"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnLockClicked"
                                Content="Start" />
                        <Border Width="1"
                                Height="22"
                                Margin="0,7,13,0"
                                Background="#38FFFFFF" />
                        <Button Margin="0,2,7,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnFullscreenClicked"
                                Content="Fullscreen" />
                        <Button Margin="0,2,7,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnResetClicked"
                                Content="Reset" />
                        <Button Margin="0,2,0,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnCancelClicked"
                                Content="Cancel" />
                    </WrapPanel>
                </StackPanel>

                <primitives:Thumb Grid.RowSpan="3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Cursor="SizeNWSE"
                                  Style="{StaticResource CornerGripStyle}"
                                  Tag="TopLeft"
                                  DragStarted="OnResizeThumbDragStarted"
                                  DragCompleted="OnResizeThumbDragCompleted"
                                  DragDelta="OnResizeThumbDragDelta">
                    <primitives:Thumb.RenderTransform>
                        <ScaleTransform ScaleX="-1" ScaleY="-1" />
                    </primitives:Thumb.RenderTransform>
                </primitives:Thumb>
                <primitives:Thumb Grid.RowSpan="3"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Cursor="SizeNESW"
                                  Style="{StaticResource CornerGripStyle}"
                                  Tag="TopRight"
                                  DragStarted="OnResizeThumbDragStarted"
                                  DragCompleted="OnResizeThumbDragCompleted"
                                  DragDelta="OnResizeThumbDragDelta">
                    <primitives:Thumb.RenderTransform>
                        <ScaleTransform ScaleY="-1" />
                    </primitives:Thumb.RenderTransform>
                </primitives:Thumb>
                <primitives:Thumb Grid.RowSpan="3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom"
                                  Cursor="SizeNESW"
                                  Style="{StaticResource CornerGripStyle}"
                                  Tag="BottomLeft"
                                  DragStarted="OnResizeThumbDragStarted"
                                  DragCompleted="OnResizeThumbDragCompleted"
                                  DragDelta="OnResizeThumbDragDelta">
                    <primitives:Thumb.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </primitives:Thumb.RenderTransform>
                </primitives:Thumb>
                <primitives:Thumb Grid.RowSpan="3"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE"
                                  Style="{StaticResource CornerGripStyle}"
                                  Tag="BottomRight"
                                  DragStarted="OnResizeThumbDragStarted"
                                  DragCompleted="OnResizeThumbDragCompleted"
                                  DragDelta="OnResizeThumbDragDelta" />
            </Grid>

            <Border x:Name="AnnotatingUsageHint"
                    Width="260"
                    Margin="12,0,0,12"
                    Padding="9,7"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="#99000000"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Opacity="0.5"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="#DDF5F5F5" />
                        </Style>
                    </StackPanel.Resources>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Input controls" />
                        <TextBlock DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   Text="H to hide" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Left click" />
                        <TextBlock Grid.Column="1" Text="Highlight" />
                        <TextBlock Grid.Row="1" Text="Left drag" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Freehand path" />
                        <TextBlock Grid.Row="2" Text="Shift + left click" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Text" />
                        <TextBlock Grid.Row="3" Text="Shift + left drag" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Straight line" />
                        <TextBlock Grid.Row="4" Text="Right drag" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Rectangle" />
                        <TextBlock Grid.Row="5" Text="Shift + right drag" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Circle" />
                        <TextBlock Grid.Row="6" Text="ESC" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="to Exit" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0"
                               Text="&#x1F6C8; Hide usage hints in settings" />
                </StackPanel>
            </Border>

            <Border x:Name="AnnotatingUsageCollapsedHint"
                    Margin="12,0,0,12"
                    Padding="9,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="#99000000"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Opacity="0.5"
                    Visibility="Collapsed">
                <TextBlock FontSize="11" Foreground="#DDF5F5F5">
                    <Run FontWeight="Bold" Text="H" /><Run Text=" for Help" />
                </TextBlock>
            </Border>

            <!-- Sits above the drawing canvases so a pause is unmistakable, and stays out of
                 hit testing so it never becomes the reason input is ignored. -->
            <Grid x:Name="PausedOverlay"
                  IsHitTestVisible="False"
                  Opacity="0.55"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="72"
                               Foreground="#F5F5F5"
                               Text="&#xE769;" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#F5F5F5"
                               Text="Paused by the host" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
