<Window x:Class="RemotePointer.Client.Overlays.TargetRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Focusable="True"
        ResizeMode="NoResize"
        MinWidth="280"
        MinHeight="180"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseDown="OnPreviewMouseDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseUp="OnPreviewMouseUp">
    <Border x:Name="OuterBorder"
            BorderBrush="#FFCC4D"
            BorderThickness="3"
            Background="#22007ACC">
        <Grid x:Name="TargetSurface">
            <Canvas x:Name="RippleCanvas" IsHitTestVisible="False" />
            <Canvas x:Name="EditorCanvas" IsHitTestVisible="False" />

            <Border x:Name="CalibrationPanel"
                    VerticalAlignment="Top"
                    Margin="10"
                    Padding="10"
                    Background="#E6111720"
                    BorderBrush="#627087"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <Border x:Name="DragSurface"
                            Padding="4"
                            Background="Transparent"
                            MouseLeftButtonDown="OnDragSurfaceMouseLeftButtonDown">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="#AAB5C7"
                                       Text="Drag here to move" />
                            <TextBlock Foreground="White"
                                       FontWeight="SemiBold"
                                       Text="Calibrate target area" />
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="DimensionsText"
                               Margin="4,7,4,0"
                               Foreground="#E9EDF5" />
                    <TextBlock x:Name="ExpectedAspectText"
                               Margin="4,3,4,0"
                               Foreground="#AAB5C7" />
                    <TextBlock x:Name="AspectWarningText"
                               Margin="4,5,4,0"
                               Foreground="#FF9D9D"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <WrapPanel Margin="4,9,0,0">
                        <CheckBox x:Name="AspectLockCheckBox"
                                  Margin="0,0,14,8"
                                  Foreground="White"
                                  VerticalAlignment="Center"
                                  Checked="OnAspectLockChanged"
                                  Unchecked="OnAspectLockChanged"
                                  Content="Lock aspect ratio" />
                        <CheckBox x:Name="AllowOverrideCheckBox"
                                  Margin="0,0,14,8"
                                  Foreground="#FFB3B3"
                                  VerticalAlignment="Center"
                                  Content="Allow mismatch"
                                  Visibility="Collapsed" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Margin="4,0,8,4"
                                Padding="12,6"
                                Click="OnLockClicked"
                                Content="Lock region" />
                        <Button Margin="0,0,8,4"
                                Padding="12,6"
                                Click="OnFullscreenClicked"
                                Content="Fullscreen" />
                        <Button Margin="0,0,8,4"
                                Padding="12,6"
                                Click="OnResetClicked"
                                Content="Reset" />
                        <Button Margin="0,0,4,4"
                                Padding="12,6"
                                Click="OnCancelClicked"
                                Content="Cancel" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <primitives:Thumb x:Name="ResizeThumb"
                              Width="24"
                              Height="24"
                              Margin="0,0,3,3"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Cursor="SizeNWSE"
                              DragStarted="OnResizeThumbDragStarted"
                              DragCompleted="OnResizeThumbDragCompleted"
                              DragDelta="OnResizeThumbDragDelta">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="#DDFFCC4D">
                            <Path Margin="5"
                                  Data="M 0 12 L 12 0 M 5 12 L 12 5"
                                  Stroke="#202020"
                                  StrokeThickness="2" />
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Grid>
    </Border>
</Window>
