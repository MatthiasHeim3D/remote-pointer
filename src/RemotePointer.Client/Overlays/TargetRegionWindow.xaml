<Window x:Class="RemotePointer.Client.Overlays.TargetRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Focusable="True"
        ResizeMode="NoResize"
        MinWidth="280"
        MinHeight="180"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseDown="OnPreviewMouseDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseUp="OnPreviewMouseUp">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#F5F5F5" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#60CDFF" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="#F5F5F5" />
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder"
            BorderBrush="#60CDFF"
            BorderThickness="3"
            Background="#16000000"
            CornerRadius="6">
        <Grid x:Name="TargetSurface">
            <Canvas x:Name="RippleCanvas" IsHitTestVisible="False" />
            <Canvas x:Name="EditorCanvas" IsHitTestVisible="False" />

            <Border x:Name="CalibrationPanel"
                    MaxWidth="540"
                    Margin="12"
                    Padding="14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#F2242424"
                    BorderBrush="#505050"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Direction="270"
                                      Opacity="0.45"
                                      ShadowDepth="5" />
                </Border.Effect>
                <StackPanel>
                    <Border x:Name="DragSurface"
                            Margin="-4,-4,-4,0"
                            Padding="4,4,4,9"
                            Background="Transparent"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="OnDragSurfaceMouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    Background="#60CDFF"
                                    CornerRadius="6">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="#17242A"
                                           Text="&#xE7C9;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="Calibrate target area" />
                                <TextBlock FontSize="10"
                                           Foreground="#AFAFAF"
                                           Text="Move and resize this window over the shared screen" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="#AFAFAF"
                                       Text="&#xE7C2;"
                                       ToolTip="Drag to move" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="AspectWarningPanel"
                                Margin="0,2,0,10"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#FFB900"
                                   Text="&#xE7BA;" />
                        <TextBlock Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFD36A"
                                   Text="Aspect ratio mismatch" />
                    </StackPanel>

                    <WrapPanel Margin="0,0,0,11">
                        <CheckBox x:Name="AspectLockCheckBox"
                                  Margin="0,0,10,5"
                                  Checked="OnAspectLockChanged"
                                  Unchecked="OnAspectLockChanged"
                                  Content="Lock aspect ratio" />
                    </WrapPanel>

                    <WrapPanel>
                        <Button Margin="0,0,8,6"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnLockClicked"
                                Content="Start" />
                        <Button Margin="0,0,8,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnFullscreenClicked"
                                Content="Fullscreen" />
                        <Button Margin="0,0,8,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnResetClicked"
                                Content="Reset" />
                        <Button Margin="0,0,0,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnCancelClicked"
                                Content="Cancel" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="PointingExitHint"
                    Margin="0,12,12,0"
                    Padding="9,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#99000000"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock FontSize="11"
                           Foreground="#DDF5F5F5"
                           Text="ESC to Exit" />
            </Border>

            <primitives:Thumb x:Name="ResizeThumb"
                              Width="26"
                              Height="26"
                              Margin="0,0,4,4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Cursor="SizeNWSE"
                              DragStarted="OnResizeThumbDragStarted"
                              DragCompleted="OnResizeThumbDragCompleted"
                              DragDelta="OnResizeThumbDragDelta">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border Background="#E660CDFF" CornerRadius="5">
                            <Path Margin="6"
                                  Data="M 0 12 L 12 0 M 5 12 L 12 5"
                                  Stroke="#17242A"
                                  StrokeThickness="2" />
                        </Border>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Grid>
    </Border>
</Window>
