<Window x:Class="RemotePointer.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Pointer"
        Width="760"
        Height="760"
        MinWidth="680"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#10141D">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9EDF5" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Foreground" Value="#10141D" />
            <Setter Property="Background" Value="#9FC8FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#202736" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#46536A" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
    </Window.Resources>

    <TabControl Background="#10141D" BorderThickness="0">
        <TabItem Header="Receive pointers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Receive pointers" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#AEB8C8"
                           TextWrapping="Wrap"
                           Text="Choose the monitor where incoming pointer markers should appear, then set this receiver to Available." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,0,0,18"
                    Padding="20"
                    Background="#181E2A"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="1. Select receiver monitor" />
                    <DockPanel Margin="0,12,0,0" IsEnabled="{Binding CanSelectMonitor}">
                        <Button DockPanel.Dock="Right"
                                Margin="10,0,0,0"
                                Command="{Binding RefreshMonitorsCommand}"
                                Content="Refresh" />
                        <ComboBox MinHeight="38"
                                  Padding="8,5"
                                  ItemsSource="{Binding Monitors}"
                                  SelectedItem="{Binding SelectedMonitor}"
                                  IsEnabled="{Binding CanSelectMonitor}"
                                  DisplayMemberPath="SelectionLabel" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,0,0,18"
                    Padding="20"
                    Background="#181E2A"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="2. Availability" />
                    <TextBlock Margin="0,6,0,0" Foreground="#AEB8C8" TextWrapping="Wrap">
                        <Run Text="Relay: " />
                        <Run Text="{Binding ReceiverServerUrl, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,3,0,12" Foreground="#AEB8C8"
                               Text="{Binding ReceiverConnectionMessage, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,6"
                               Foreground="#AEB8C8"
                               Text="Receiver state" />
                    <ComboBox MinHeight="38"
                              Padding="8,5"
                              IsEnabled="{Binding CanSetReceiverAvailability}"
                              ItemsSource="{Binding ReceiverAvailabilityOptions}"
                              SelectedItem="{Binding ReceiverAvailability, Mode=TwoWay}" />
                    <TextBlock Margin="0,4,0,10"
                               Foreground="#AEB8C8"
                               TextWrapping="Wrap"
                               Text="{Binding ReceiverDiscoveryMessage, Mode=OneWay}" />
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding PendingPresenterName, Mode=OneWay}" />
                    <Button Margin="0,10,8,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ApprovePresenterCommand}"
                            Content="Approve presenter" />
                    <Button Margin="0,10,8,0"
                            HorizontalAlignment="Left"
                            Background="#C35E65"
                            Foreground="White"
                            Visibility="{Binding HasConnectedPresenter, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DisconnectAllConnectionsCommand}"
                            Content="Disconnect all connections" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Padding="16" Background="#181E2A" CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Status" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding StatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8FDCB5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="#FF9999" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" Foreground="#AEB8C8">
                        <Run Text="Overlay visible: " />
                        <Run Text="{Binding IsOverlayVisible, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
        </TabItem>

        <TabItem Header="Point at another screen">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Point at another screen" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#AEB8C8"
                                   TextWrapping="Wrap"
                                   Text="Calibrate the part of your screen that contains the colleague's shared desktop. In pointing mode, pointer gestures inside that rectangle are consumed locally and converted to normalized coordinates." />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,0,0,18"
                            Padding="20"
                            Background="#181E2A"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="1. Connect to receiver" />
                            <TextBlock Margin="0,6,0,0" Foreground="#AEB8C8" TextWrapping="Wrap">
                                <Run Text="Relay: " />
                                <Run Text="{Binding Presenter.ServerUrl, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,12" Foreground="#AEB8C8"
                                       Text="{Binding Presenter.ConnectionMessage, Mode=OneWay}" />
                            <TextBlock Margin="0,0,0,6"
                                       Foreground="#AEB8C8"
                                       Text="Choose a visible receiver" />
                            <DockPanel IsEnabled="{Binding Presenter.ReceiverDiscoveryEnabled}">
                                <Button DockPanel.Dock="Right"
                                        Margin="10,0,0,0"
                                        Command="{Binding Presenter.RefreshReceiversCommand}"
                                        Content="Refresh list" />
                                <ComboBox MinHeight="38"
                                          Padding="8,5"
                                          ItemsSource="{Binding Presenter.AvailableReceivers}"
                                          SelectedItem="{Binding Presenter.SelectedReceiver}"
                                          DisplayMemberPath="DisplayName" />
                            </DockPanel>
                            <Button Margin="0,8,8,0"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding Presenter.ReceiverDiscoveryEnabled}"
                                    Command="{Binding Presenter.JoinDiscoveredReceiverCommand}"
                                    Content="Request access to selected receiver" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#AEB8C8"
                                       TextWrapping="Wrap"
                                       Text="{Binding Presenter.ReceiverDiscoveryMessage, Mode=OneWay}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Command="{Binding Presenter.EndSessionCommand}"
                                        Background="#C35E65"
                                        Foreground="White"
                                        Content="Disconnect" />
                            </WrapPanel>
                            <TextBlock Margin="0,3,0,0" Foreground="#AEB8C8">
                                <Run Text="Connected: " />
                                <Run Text="{Binding Presenter.IsSessionApproved, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,0,0,18"
                            Padding="20"
                            Background="#181E2A"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="2. Receiver display shape" />
                            <TextBlock Margin="0,6,0,12"
                                       Foreground="#AEB8C8"
                                       Text="Synced automatically from the approved receiver." />
                            <TextBlock FontFamily="Consolas"
                                       FontSize="18"
                                       Text="{Binding Presenter.ReceiverDisplayShape, Mode=OneWay}" />
                            <Button Margin="0,16,8,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding Presenter.CalibrateCommand}"
                                    Content="Calibrate target area" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,0,0,18"
                            Padding="20"
                            Background="#181E2A"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="3. Pointing mode" />
                            <TextBlock Margin="0,6,0,12"
                                       Foreground="#AEB8C8"
                                       TextWrapping="Wrap"
                                        Text="Left-click to highlight; left-drag to draw; Shift+left-drag for a line; Shift+left-click for text; right-drag for a box. Press Esc to stop." />
                            <WrapPanel>
                                <Button Command="{Binding Presenter.TogglePointingCommand}"
                                        Content="Toggle pointing (Ctrl+Alt+P)" />
                                <Button Background="#4A5568"
                                        Foreground="White"
                                        Command="{Binding Presenter.ExitPointingCommand}"
                                        Content="Exit pointing" />
                            </WrapPanel>
                            <TextBlock Margin="0,10,0,0" Foreground="#AEB8C8">
                                <Run Text="State: " />
                                <Run Text="{Binding Presenter.StateLabel, Mode=OneWay}" />
                                <Run Text="  •  Captured locally: " />
                                <Run Text="{Binding Presenter.CapturedPointerCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#E9EDF5"
                                       Text="{Binding Presenter.LastPointer, Mode=OneWay}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#AEB8C8"
                                       Text="{Binding Presenter.LastAcknowledgement, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Padding="16" Background="#181E2A" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Presenter status" />
                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding Presenter.StatusMessage, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8FDCB5" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Presenter.IsError}" Value="True">
                                                <Setter Property="Foreground" Value="#FF9999" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
