<Window x:Class="RemotePointer.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:RemotePointer.Client.ViewModels"
        xmlns:views="clr-namespace:RemotePointer.Client.Views"
        Title="Remote Pointer"
        Width="400"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewMouseDown="OnPreviewMouseDown"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <views:ProfilePictureConverter x:Key="ProfilePictureConverter" />
        <views:ProfilePictureFallbackVisibilityConverter
            x:Key="ProfilePictureFallbackVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#F5F5F5" />
        </Style>

        <Style TargetType="Image">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Opacity="0"
                                              Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Background="#686868">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Opacity="0"
                                              Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#353535" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#454545" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#60CDFF" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#343434" />
            <Setter Property="Foreground" Value="#F5F5F5" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track"
                                    Width="38"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="#555555"
                                    CornerRadius="10">
                                <Ellipse x:Name="Knob"
                                         Width="14"
                                         Height="14"
                                         Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="White" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#60CDFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="#17242A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#292929" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="SelectionBrush" Value="#39789C" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Background="#242424"
            BorderBrush="#454545"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.55"
                              ShadowDepth="6"
                              Color="Black" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <!-- Main sender view -->
            <Grid Grid.Row="0" Margin="20,18,20,14">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Disconnected client list -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Presenter.IsSessionApproved}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasConnectedPresenter}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Available clients" />
                    <TextBlock Grid.Row="1"
                               Margin="0,5,0,12"
                               Foreground="#AFAFAF"
                               Text="Choose a screen to point at" />

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding Presenter.AvailableReceivers}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ClientRow"
                                            Height="58"
                                            Padding="12,0,8,0"
                                            Background="#2D2D2D"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32"
                                                    Height="32"
                                                    Background="#3A3A3A"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="16"
                                                               Foreground="#60CDFF"
                                                               Visibility="{Binding ProfilePicturePng, Converter={StaticResource ProfilePictureFallbackVisibilityConverter}}"
                                                               Text="&#xE77B;" />
                                                    <Image Source="{Binding ProfilePicturePng, Converter={StaticResource ProfilePictureConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Margin="9,0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2"
                                                    Height="32"
                                                    Padding="13,0"
                                                    Command="{Binding DataContext.Presenter.JoinDiscoveredReceiverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Connect">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ClientRow}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Presenter.AvailableReceivers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="30"
                                       Foreground="#777777"
                                       Text="&#xE774;" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="#C8C8C8"
                                       Text="No available clients" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="#858585"
                                       Text="Refresh or wait for a client to appear" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="#AFAFAF"
                               Text="{Binding Presenter.StatusMessage}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Connected sender controls -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Presenter.IsSessionApproved}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasConnectedPresenter}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Foreground="#AFAFAF" Text="Connected to" />
                    <StackPanel Grid.Row="1"
                                Margin="0,5,0,0"
                                Orientation="Horizontal">
                        <Border Width="36"
                                Height="36"
                                Background="#343434"
                                CornerRadius="5">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="#60CDFF"
                                       Text="&#xE7F8;" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding Presenter.CurrentReceiverName}" />
                            <TextBlock FontSize="11"
                                       Foreground="#6CCB7F"
                                       Text="Connected" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Margin="0,18,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding Presenter.TogglePointingCommand}"
                            Content="{Binding Presenter.PointingActionLabel}" />

                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                        <TextBlock FontSize="12"
                                   Foreground="#AFAFAF"
                                   Text="{Binding Presenter.StatusMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="#777777"
                                   Text="Ctrl+Alt+P toggles pointing" />
                    </StackPanel>

                    <Button Grid.Row="4"
                            Height="42"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="#C42B1C"
                            Foreground="White"
                            Command="{Binding Presenter.EndSessionCommand}"
                            Content="Disconnect from receiver" />
                </Grid>

                <!-- Receiver-connected state takes precedence over sender discovery. -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConnectedPresenter}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42"
                                Height="42"
                                Background="#173B2A"
                                CornerRadius="7">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="20"
                                       Foreground="#6CCB7F"
                                       Text="&#xE8B7;" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Receiving pointers" />
                            <TextBlock FontSize="11"
                                       Foreground="#6CCB7F"
                                       Text="{Binding ConnectedPresenterCountLabel}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Margin="0,18,0,8"
                               Foreground="#AFAFAF"
                               Text="Connected senders" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding ConnectedPresenters}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Height="48"
                                        Padding="11,0"
                                        Background="#2D2D2D"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="28"
                                                Background="#3A3A3A"
                                                CornerRadius="14">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="#60CDFF"
                                                       Text="&#xE77B;" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Margin="9,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#6CCB7F" />
                                            <TextBlock Margin="6,0,0,0"
                                                       FontSize="10"
                                                       Foreground="#AFAFAF"
                                                       Text="Receiving" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3"
                            Height="42"
                            Margin="0,14,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="#C42B1C"
                            Foreground="White"
                            Command="{Binding DisconnectAllConnectionsCommand}"
                            Content="Disconnect all senders" />
                </Grid>
            </Grid>

            <!-- Settings view -->
            <Grid Grid.Row="0"
                  Margin="20,14,14,14"
                  Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Settings" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleSettingsCommand}"
                            Content="&#xE711;"
                            ToolTip="Close settings" />
                </Grid>
                <ScrollViewer Grid.Row="1"
                              Padding="0,0,8,0"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                    <TextBlock Margin="0,0,0,18"
                               Foreground="#AFAFAF"
                               Text="Connection and profile" />

                    <TextBlock Margin="0,0,0,6" Text="Receiving screen" />
                    <ComboBox Height="36"
                              Padding="8,5"
                              ItemsSource="{Binding Monitors}"
                              SelectedItem="{Binding SelectedMonitor}"
                              DisplayMemberPath="Display.DisplayName"
                              IsEnabled="{Binding CanSelectMonitor}" />

                    <TextBlock Margin="0,16,0,6" Text="Server address" />
                    <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,6" Text="Username" />
                    <TextBox MaxLength="128"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,6" Text="User profile picture" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38"
                                Height="38"
                                Background="#3A3A3A"
                                CornerRadius="19">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Visibility="{Binding ProfilePicturePath, Converter={StaticResource ProfilePictureFallbackVisibilityConverter}}"
                                           Text="{Binding ProfileInitials}" />
                                <Image Source="{Binding ProfilePicturePath}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#AFAFAF"
                                   Text="{Binding ProfilePicturePath}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2"
                                Width="72"
                                Height="34"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnBrowseProfilePicture"
                                Content="Browse" />
                    </Grid>

                    <TextBlock Margin="0,16,0,6" Text="Maximum connected senders" />
                    <Grid Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.ColumnSpan="2"
                                 MaxLength="2"
                                 Padding="10,7,32,7"
                                 Text="{Binding MaximumSenderConnections, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Grid.Column="1" Margin="0,1,1,1">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Button Width="Auto"
                                    Height="Auto"
                                    Padding="0"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="#343434"
                                    BorderThickness="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Command="{Binding IncrementMaximumSendersCommand}"
                                    Content="&#xE70E;" />
                            <Button Grid.Row="1"
                                    Width="Auto"
                                    Height="Auto"
                                    Padding="0"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="#343434"
                                    BorderThickness="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Command="{Binding DecrementMaximumSendersCommand}"
                                    Content="&#xE70D;" />
                        </Grid>
                    </Grid>
                    <TextBlock Margin="0,5,0,0"
                               FontSize="10"
                               Foreground="#858585"
                               Text="Default: 2. This limit applies when a receiver session starts." />

                    <CheckBox Margin="0,18,0,0"
                              Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IsLaunchAtStartup}"
                              Content="Launch at startup" />

                    <TextBlock Margin="0,16,0,14"
                               FontSize="11"
                               Foreground="#858585"
                               Text="Connection and advertised profile changes apply after restarting Remote Pointer."
                               TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom profile and settings bar -->
            <Border Grid.Row="1"
                    Background="#202020"
                    BorderBrush="#343434"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ProfileButton"
                            Height="46"
                            HorizontalAlignment="Left"
                            Padding="5,0,12,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleAvailabilityMenuCommand}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="34" Height="34">
                                <Border Background="#3A3A3A" CornerRadius="17">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Visibility="{Binding ProfilePicturePath, Converter={StaticResource ProfilePictureFallbackVisibilityConverter}}"
                                                   Text="{Binding ProfileInitials}" />
                                        <Image Source="{Binding ProfilePicturePath}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <Ellipse Width="11"
                                         Height="11"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Fill="{Binding AvailabilityColor}"
                                         Stroke="#202020"
                                         StrokeThickness="2" />
                            </Grid>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock MaxWidth="180"
                                           FontWeight="SemiBold"
                                           Foreground="#F4F4F4"
                                           Text="{Binding UserName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="10"
                                           Foreground="#AFAFAF"
                                           Text="{Binding AvailabilityLabel}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleSettingsCommand}"
                            Content="&#xE713;"
                            ToolTip="Settings" />
                </Grid>
            </Border>

            <!-- Availability chooser stays inside the flyout so it does not deactivate the window. -->
            <Border x:Name="AvailabilityPanel"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Panel.ZIndex="20"
                    Width="244"
                    Margin="16,0,0,66"
                    Padding="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="#303030"
                    BorderBrush="#505050"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="{Binding IsAvailabilityMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Margin="10,6,10,8"
                               FontWeight="SemiBold"
                               Text="Set availability" />
                    <Button Height="42"
                            Padding="10,0"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding SetReceiverAvailabilityCommand}"
                            CommandParameter="{x:Static viewModels:ReceiverAvailability.Available}"
                            Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#6CCB7F" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Available" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#60CDFF"
                                       Text="&#xE73E;">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReceiverAvailability}"
                                                         Value="{x:Static viewModels:ReceiverAvailability.Available}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Height="42"
                            Padding="10,0"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding SetReceiverAvailabilityCommand}"
                            CommandParameter="{x:Static viewModels:ReceiverAvailability.Invisible}"
                            Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#8B8B8B" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Invisible" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#60CDFF"
                                       Text="&#xE73E;">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReceiverAvailability}"
                                                         Value="{x:Static viewModels:ReceiverAvailability.Invisible}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
