<Window x:Class="RemotePointer.Client.Views.ConnectionApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemotePointer.Client.Views"
        Title="Remote Pointer connection request"
        Width="360"
        Height="164"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="OnLoaded">
    <Window.Resources>
        <local:ProfilePictureConverter x:Key="ProfilePictureConverter" />
        <local:ProfilePictureFallbackVisibilityConverter
            x:Key="ProfilePictureFallbackVisibilityConverter" />
    </Window.Resources>
    <Border Margin="8"
            Padding="16"
            Background="#242424"
            BorderBrush="#505050"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              Direction="270"
                              Opacity="0.55"
                              ShadowDepth="5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <Border DockPanel.Dock="Left"
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        Background="#3A3A3A"
                        CornerRadius="16">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#60CDFF"
                                   Visibility="{Binding AnnotatorProfilePicturePng, Converter={StaticResource ProfilePictureFallbackVisibilityConverter}}"
                                   Text="&#xE77B;" />
                        <Ellipse RenderOptions.BitmapScalingMode="HighQuality">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AnnotatorProfilePicturePng, Converter={StaticResource ProfilePictureConverter}}"
                                            Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Border>
                <StackPanel>
                    <TextBlock FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F5F5F5"
                               Text="Connection request" />
                    <TextBlock x:Name="AnnotatorNameText"
                               Margin="0,3,0,0"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#BEBEBE"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
            <TextBlock Grid.Row="1"
                       Margin="0,10,0,8"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#AFAFAF"
                       Text="Allow this user to point at your selected screen?" />
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="82"
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Background="#383838"
                        BorderThickness="0"
                        Foreground="#F5F5F5"
                        Click="OnNotNowClicked"
                        Content="Not now"
                        Cursor="Hand" />
                <Button Width="82"
                        Height="32"
                        Padding="12,0"
                        Background="#60CDFF"
                        BorderThickness="0"
                        Foreground="#101010"
                        FontWeight="SemiBold"
                        Click="OnApproveClicked"
                        Content="Allow"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
