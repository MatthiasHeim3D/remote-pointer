{
  "Sessions": {
    "PairingCodeLifetimeMinutes": 10,
    "MaximumSessionHours": 8,
    "SequenceWindowSize": 64,
    "ReceiverDiscoveryEnabled": true
  },
  "RateLimits": {
    "EventsPerSecond": 20,
    "BurstSize": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "LogPointerCoordinates": false
  }
}
