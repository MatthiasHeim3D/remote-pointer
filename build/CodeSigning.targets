<Project>
  <PropertyGroup>
    <EnableCodeSigning Condition="'$(EnableCodeSigning)' == ''">false</EnableCodeSigning>
    <SignToolPath Condition="'$(SignToolPath)' == ''">signtool.exe</SignToolPath>
    <CodeSigningTimestampUrl Condition="'$(CodeSigningTimestampUrl)' == ''">https://timestamp.digicert.com</CodeSigningTimestampUrl>
  </PropertyGroup>

  <Target Name="ValidateClientCodeSigning"
          BeforeTargets="Publish"
          Condition="'$(EnableCodeSigning)' == 'true'">
    <Error Condition="'$(CodeSigningCertificateThumbprint)' == ''"
           Text="CodeSigningCertificateThumbprint is required when EnableCodeSigning=true." />
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64'"
           Text="The initial signed client deployment target must use RuntimeIdentifier=win-x64." />
  </Target>

  <Target Name="AuthenticodeSignClient"
          AfterTargets="Publish"
          Condition="'$(EnableCodeSigning)' == 'true'">
    <ItemGroup>
      <_RemotePointerFilesToSign Include="$(PublishDir)RemotePointer.Client.exe"
                                 Condition="Exists('$(PublishDir)RemotePointer.Client.exe')" />
      <_RemotePointerFilesToSign Include="$(PublishDir)RemotePointer.Client.dll"
                                 Condition="Exists('$(PublishDir)RemotePointer.Client.dll')" />
    </ItemGroup>
    <Error Condition="'@(_RemotePointerFilesToSign)' == ''"
           Text="No Remote Pointer client artifacts were found to sign in $(PublishDir)." />
    <Exec Command="&quot;$(SignToolPath)&quot; sign /sha1 &quot;$(CodeSigningCertificateThumbprint)&quot; /fd SHA256 /tr &quot;$(CodeSigningTimestampUrl)&quot; /td SHA256 $(CodeSigningAdditionalArguments) &quot;%(_RemotePointerFilesToSign.Identity)&quot;" />
  </Target>
</Project>
